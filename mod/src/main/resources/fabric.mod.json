{
  "schemaVersion": 1,
  "id": "catgirl",
  "version": "${version}",
  "name": "Catgirl Client",
  "description": "The Catgirl Launcher title screen: pink branding, CatGirl Client window title, catgirl splash texts, a quick-access menu and free cosmetics (cat ears, tail, bow).",
  "authors": [
    "Jerrix"
  ],
  "license": "MIT",
  "icon": "assets/catgirl/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.catgirl.client.CatgirlClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-screen-api-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-rendering-v1": "*"
  }
}
